{
  "name": "hero-coding",
  "version": "0.1.0",
  "description": "Minimal autonomous coding agent MVP. User story in, git commits out.",
  "type": "module",
  "private": true,
  "bin": {
    "hero": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "watch": "tsx src/cli.ts watch",
    "story": "tsx src/cli.ts story",
    "setup-target": "bash scripts/setup-target.sh",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "chokidar": "^4.0.3",
    "dotenv": "^16.4.7",
    "gray-matter": "^4.0.3",
    "openai": "^4.77.0",
    "simple-git": "^3.27.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
