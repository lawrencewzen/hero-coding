# --- Worker (atomic task executor) ---
# OpenAI-compatible. Any of: Ling, OpenAI, DeepSeek, ChatGPT-via-coproxy, Claude (via openai-compat shim), etc.
WORKER_BASE_URL=https://api.ant-ling.com/v1
WORKER_API_KEY=sk-studio-XXXXXXXXXXXXXXXX
WORKER_MODEL=Ling-2.6-flash

# --- Judge (verdict over git log + diff) ---
JUDGE_BASE_URL=https://api.ant-ling.com/v1
JUDGE_API_KEY=sk-studio-XXXXXXXXXXXXXXXX
JUDGE_MODEL=Ling-2.5-1T

# --- Optional: dev with coproxy (local ChatGPT reverse proxy) ---
# WORKER_BASE_URL=http://localhost:6890/v1
# WORKER_API_KEY=sk-coproxy-XXXXXXXX
# WORKER_MODEL=gpt-5.4

# --- Workspace ---
# Path to the target codebase the worker operates on (must be a git repo)
TARGET_REPO=/absolute/path/to/target-repo

# Max outer retries per user story
MAX_RETRIES=3
