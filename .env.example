# --- Worker (atomic task executor via pi CLI) ---
# pi reads provider config from pi-config/models.json
WORKER_PROVIDER=coproxy
WORKER_MODEL=gpt-5.4

# --- Judge (verdict over git log + diff, uses OpenAI SDK) ---
# Any OpenAI-compatible Chat Completions API
JUDGE_BASE_URL=https://api.example.com/v1
JUDGE_API_KEY=sk-XXXXXXXXXXXXXXXX
JUDGE_MODEL=gpt-5.4

# --- API keys (read by pi via models.json apiKey reference) ---
# Set this to the key your provider expects
# MY_API_KEY=sk-XXXXXXXXXXXXXXXX

# --- Workspace ---
TARGET_REPO=/absolute/path/to/target-repo
TARGET_BASE_REF=main

# --- Max retries ---
MAX_RETRIES=3
