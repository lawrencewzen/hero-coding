# =============================================================================
# Providers — define each LLM endpoint once, refer to it by name below.
# Pattern: HERO_PROVIDER_<name>_{BASE_URL,API_KEY,INSECURE_TLS}
# Add as many as you need; <name> can be any [A-Za-z0-9._-]+ identifier.
# =============================================================================

HERO_PROVIDER_coproxy_BASE_URL=https://localhost:8443/v1
HERO_PROVIDER_coproxy_API_KEY=sk-XXXXXXXXXXXXXXXX
HERO_PROVIDER_coproxy_INSECURE_TLS=true   # accept self-signed cert (dev-only)

# Optional second provider — uncomment to enable.
# HERO_PROVIDER_openai_BASE_URL=https://api.openai.com/v1
# HERO_PROVIDER_openai_API_KEY=sk-XXXXXXXXXXXXXXXX

# =============================================================================
# Role bindings — "<provider>/<model>". Switching is one line.
# =============================================================================

HERO_WORKER=coproxy/gpt-5.4
HERO_JUDGE=coproxy/gpt-5.4

# Examples of switching:
#   HERO_WORKER=coproxy/claude-4.7      # different model, same provider
#   HERO_JUDGE=openai/gpt-5.5           # different provider entirely
# Or run a one-off:
#   HERO_WORKER=openai/gpt-5.5 ./hero run inbox/us-001.md

# =============================================================================
# Workspace
# =============================================================================

TARGET_REPO=/absolute/path/to/target-repo
TARGET_BASE_REF=main

# =============================================================================
# Limits
# =============================================================================

MAX_RETRIES=3
MAX_PARALLEL=2

# Default verifier commands (newline-separated) when a story has no `verify:`.
# HERO_DEFAULT_VERIFY=npm test
# HERO_VERIFY_TIMEOUT_MS=120000
