# --- Worker (native agent loop, OpenAI-compatible chat completions) ---
WORKER_BASE_URL=https://api.example.com/v1
WORKER_API_KEY=sk-XXXXXXXXXXXXXXXX
WORKER_MODEL=gpt-5.4

# --- Judge (verdict over git log + diff, OpenAI-compatible chat completions) ---
JUDGE_BASE_URL=https://api.example.com/v1
JUDGE_API_KEY=sk-XXXXXXXXXXXXXXXX
JUDGE_MODEL=gpt-5.4

# --- Workspace ---
TARGET_REPO=/absolute/path/to/target-repo
TARGET_BASE_REF=main

# --- Limits ---
MAX_RETRIES=3
MAX_PARALLEL=2

# --- Default verifier commands (newline-separated) ---
# Used when a story has no `verify:` field. Empty = no default verification.
# HERO_DEFAULT_VERIFY=npm test
# HERO_VERIFY_TIMEOUT_MS=120000
